#!/bin/zsh

set -eu

script_dir="${0:A:h}"
source_root="${script_dir:h}"
policy_root="${CLERK_POLICY_ROOT:-${source_root:h}/clerk-task-policy-preview}"
town_root="${GT_ROOT:-/Users/admin/gt}"
clerk_home="$town_root/clerk"
command_link="${GT_COMMAND_LINK:-/opt/homebrew/bin/gt}"
install_root="${GT_INSTALL_ROOT:-/Users/admin/.local/bin}"
installed_binary="$install_root/gt-native-clerk"
mode="${1:-install}"
timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
backup_root="$clerk_home/backups/native-clerk-$timestamp"
build_root="$(mktemp -d /private/tmp/native-clerk-build.XXXXXX)"
export GOCACHE="${GOCACHE:-/private/tmp/gt-go-cache}"

cleanup() {
  rm -rf "$build_root"
}
trap cleanup EXIT

die() {
  printf 'install-native-clerk: %s\n' "$1" >&2
  exit 1
}

backup_file() {
  local target="$1"
  local relative

  test -e "$target" || test -L "$target" || return 0
  if [[ "$target" == "$town_root/"* ]]; then
    relative="town/${target#$town_root/}"
  else
    relative="external$target"
  fi
  mkdir -p "$backup_root/${relative:h}"
  cp -pP "$target" "$backup_root/$relative"
}

check_sources() {
  test -d "$source_root/.git" || die "not a Gas Town source checkout: $source_root"
  test -f "$source_root/internal/cmd/clerk.go" || die "native Clerk command is missing"
  test -f "$source_root/internal/herdr/client.go" || die "Herdr adapter is missing"
  test -d "$policy_root" || die "Clerk policy package is missing: $policy_root"

  jq empty "$policy_root/clerk.json" "$policy_root/clerk.schema.json" "$policy_root/sync.json"
  CLERK_CONFIG="$policy_root/clerk.json" \
    CLERK_SYNC_STATE="$policy_root/sync.json" \
    "$policy_root/validate-config"
  zsh -n "$policy_root/validate-config" "$policy_root/guard-clickup-scope"
}

format_build_and_test() {
  command -v go >/dev/null 2>&1 || die "Go is required: brew install go"
  command -v gofmt >/dev/null 2>&1 || die "gofmt is required"
  mkdir -p "$GOCACHE"

  gofmt -w \
    "$source_root/internal/herdr" \
    "$source_root/internal/clerk" \
    "$source_root/internal/cmd/clerk.go" \
    "$source_root/internal/cmd/sling.go" \
    "$source_root/internal/cmd/sling_dispatch.go" \
    "$source_root/internal/cmd/prime.go" \
    "$source_root/internal/cmd/prime_output.go" \
    "$source_root/internal/cmd/role.go" \
    "$source_root/internal/config/env.go" \
    "$source_root/internal/config/roles.go" \
    "$source_root/internal/config/roles_test.go" \
    "$source_root/internal/constants/constants.go" \
    "$source_root/internal/mail/resolve.go" \
    "$source_root/internal/mail/router.go" \
    "$source_root/internal/session/identity.go" \
    "$source_root/internal/session/names.go" \
    "$source_root/internal/session/names_test.go" \
    "$source_root/internal/tmux/tmux.go"

  (
    cd "$source_root"
    local version commit build_time
    version="$(git describe --tags --always --dirty 2>/dev/null || printf dev)-clerk"
    commit="$(git rev-parse --short HEAD 2>/dev/null || printf unknown)"
    build_time="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

    git diff --check
    go test ./internal/herdr ./internal/clerk ./internal/session
    go test ./internal/config -run 'Test(AllRoles|TownRoles|AgentEnv|LoadRoleDefinition|RoleSettingsDir)'
    go test ./internal/cmd -run '^TestNativeClerkCompileOnly$'
    go test ./internal/tmux ./internal/witness ./internal/refinery ./internal/mail \
      -run '^TestNativeClerkCompileOnly$'
    go build -ldflags \
      "-s -w -X github.com/steveyegge/gastown/internal/cmd.Version=$version -X github.com/steveyegge/gastown/internal/cmd.Commit=$commit -X github.com/steveyegge/gastown/internal/cmd.BuildTime=$build_time -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1" \
      -o "$build_root/gt" ./cmd/gt
  )

  "$build_root/gt" version
}

case "$mode" in
  --check)
    test "$#" -eq 1 || die "--check takes no additional arguments"
    check_sources
    format_build_and_test
    printf '%s\n' "Native Clerk source, policy, tests, and binary build passed."
    exit 0
    ;;
  install)
    test "$#" -eq 0 || die "unknown argument: $1"
    ;;
  *)
    die "unknown mode: $mode"
    ;;
esac

test -d "$town_root" || die "Gas Town does not exist: $town_root"
test -d "$clerk_home" || die "Clerk home does not exist: $clerk_home"
check_sources
format_build_and_test

mkdir -p "$backup_root" "$install_root"

backup_file "$clerk_home/clerk.json"
backup_file "$clerk_home/schema/clerk.schema.json"
backup_file "$clerk_home/bin/validate-config"
backup_file "$clerk_home/CLAUDE.md"
backup_file "$clerk_home/AGENTS.md"
backup_file "$town_root/settings/config.json"
backup_file "$installed_binary"
backup_file "$command_link"

install -m 700 "$build_root/gt" "$installed_binary"
install -m 600 "$policy_root/clerk.json" "$clerk_home/clerk.json"
install -m 600 "$policy_root/clerk.schema.json" "$clerk_home/schema/clerk.schema.json"
install -m 700 "$policy_root/validate-config" "$clerk_home/bin/validate-config"
install -m 600 "$policy_root/NATIVE-CLERK-CLAUDE.md" "$clerk_home/CLAUDE.md"
install -m 600 "$policy_root/NATIVE-CLERK-AGENTS.md" "$clerk_home/AGENTS.md"

(
  cd "$town_root"
  "$installed_binary" config agent set \
    claude-opus-4-8 \
    "claude --model claude-opus-4-8 --dangerously-skip-permissions" \
    --provider claude
  "$installed_binary" config agent set \
    claude-sonnet \
    "claude --model sonnet --dangerously-skip-permissions" \
    --provider claude
  "$installed_binary" config agent set \
    codex-gpt-5-6-sol \
    "codex --model gpt-5.6-sol --dangerously-bypass-approvals-and-sandbox" \
    --provider codex
  "$installed_binary" config agent set \
    codex-gpt-5-6-terra \
    "codex --model gpt-5.6-terra --dangerously-bypass-approvals-and-sandbox" \
    --provider codex
)

# Preserve the prior command link beside it, then activate the source build.
# Repeated installs retain every previous link and binary in timestamped backups.
mv "$command_link" "$command_link.previous-$timestamp"
ln -s "$installed_binary" "$command_link"

if ! "$clerk_home/bin/validate-config"; then
  printf 'Validation failed. Backups are in %s\n' "$backup_root" >&2
  exit 1
fi

printf '%s\n' "Native supervised Clerk Gas Town installed."
printf 'Binary: %s\n' "$installed_binary"
printf 'Previous command link: %s\n' "$command_link.previous-$timestamp"
printf 'Backups: %s\n' "$backup_root"
printf '%s\n' "Nothing was deleted. Existing repositories and Herdr sessions were not touched."
printf '%s\n' "From a Herdr terminal: cd \"$town_root\" && gt clerk start"
